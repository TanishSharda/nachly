{
  "name": "nachly-mobile",
  "version": "1.0.0",
  "description": "Nachly - AI-powered dance learning app (React Native/Expo)",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "eas-build": "eas build",
    "eas-submit": "eas submit",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "expo": "^50.0.0",
    "expo-camera": "^13.4.0",
    "expo-status-bar": "^1.10.0",
    "expo-video": "^0.1.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-screens": "^3.27.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@supabase/supabase-js": "^2.38.0",
    "@supabase/auth-js": "^2.38.0",
    "axios": "^1.6.2",
    "zustand": "^4.4.1",
    "expo-secure-store": "^12.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "expo": {
    "name": "Nachly",
    "slug": "nachly",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.nachly.app"
    },
    "android": {
      "package": "com.nachly.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nachly to use your camera for practice sessions"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Nachly to use Face ID for authentication"
        }
      ]
    ]
  }
}
